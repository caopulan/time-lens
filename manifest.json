{
  "manifest_version": 3,
  "name": "Time Lens · 划词时区转换",
  "version": "0.4.1",
  "description": "选中网页中的时间描述，对照原文解析与本地时间。支持 AoE、时区缩写和相对时间。",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "action": {
    "default_title": "Time Lens · 设置",
    "default_popup": "options.html",
    "default_icon": {"16":"icons/icon16.png","24":"icons/icon24.png","32":"icons/icon32.png","48":"icons/icon48.png"}
  },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["parser.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
